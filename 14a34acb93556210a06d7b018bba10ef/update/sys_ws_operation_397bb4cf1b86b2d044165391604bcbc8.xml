        <name>update_ritm_variables</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    const request_body = request.body.data;
    gs.info('isc_webhook/update_ritm_variables - Request Received - Request Body\r\n\r\n' + JSON.stringify(request_body));

	const gr_ritm = new GlideRecord('sc_req_item');
	if(request_body.request_id){
		gr_ritm.get('request',request_body.request_id);
	}

	for(const [key,value] of Object.entries(request_body.variables)){
		gr_ritm.variables[key] = value;
	}
	gr_ritm.update();

})(request, response);]]></operation_script>
