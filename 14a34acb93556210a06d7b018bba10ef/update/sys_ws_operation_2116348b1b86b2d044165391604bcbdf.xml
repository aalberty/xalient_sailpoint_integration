        <name>fire_wf_event</name>
        <operation_script><![CDATA[(function process( /*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    const request_body = request.body.data;
    gs.info('isc_webhook/fire_wf_event - Request Received - Request Body\r\n\r\n' + JSON.stringify(request_body));

    if (request_body.event_name == 'uarSignOffCompleted') {
        const gr_ritm = new GlideRecord('sc_req_item');
        gr_ritm.get('request', request_body.event_attributes.request_id);
        var gr_context = new GlideRecord('wf_context');
        gr_context.get('id', gr_ritm.sys_id.toString());

        var wf = new global.Workflow();
        wf.broadcastEvent(gr_context.sys_id, 'uarSignOffCompleted');
    }

})(request, response);]]></operation_script>
